{
  "name": "cashflow-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gmail bank emails -> Google Sheets cashflow template (Apps Script).",
  "scripts": {
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "upload-template": "node scripts/upload-template.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "check:browser": "npm run build && node scripts/browser-check.mjs --docwrite"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "vitest": "^5.0.3"
  }
}
