{
  "name": "cashflow-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cashflow: the screens and the shared core of the app (the Cloudflare Worker in the cashflow-worker repository serves and runs them).",
  "scripts": {
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "check:browser": "npm run build && node scripts/browser-check.mjs --docwrite"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "vitest": "^5.0.3"
  }
}
